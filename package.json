{
  "name": "testcraft-studio",
  "version": "1.0.0",
  "description": "Portfolio demo for user story refinement and test case management",
  "main": "index.js",
  "scripts": {
    "dev": "node --import tsx scripts/dev.mjs",
    "dev:ui": "vite",
    "server": "tsx server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.server.json",
    "test:unit": "tsc --project tsconfig.server.json --noEmit false --outDir .test-build && node --test .test-build/tests/*.test.js",
    "test:e2e": "node --import tsx scripts/test-e2e.mjs",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:typecheck": "tsc --noEmit -p tsconfig.e2e.json",
    "verify": "npm run typecheck && npm run test:unit && npm run build && npm run test:e2e"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true
}
